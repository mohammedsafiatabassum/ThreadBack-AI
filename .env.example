# Supabase project credentials (pre-configured, do not change)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini API key — set this as a Supabase Edge Function secret named GEMINI_API_KEY
# Do NOT put the actual key in this file or in .env
# Get a key at: https://aistudio.google.com/apikey
